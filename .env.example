# Backend API base URL (connects the frontend to FastAPI persistence & calculation endpoints)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Earth / Satellite basemap configuration (optional)
# Supported providers:
#   - esri_world_imagery (default; Esri World Imagery + World Boundaries & Places labels, no API key required for evaluation/planning)
#   - mapbox_satellite   (requires VITE_MAPBOX_ACCESS_TOKEN)
#   - custom             (requires VITE_EARTH_TILE_URL)
#   - none               (disables Earth mode and displays a setup message while retaining Normal Map)
VITE_EARTH_TILE_PROVIDER=esri_world_imagery

# Optional custom satellite tile URL template ({z}/{x}/{y} or {z}/{y}/{x}) and attribution
# VITE_EARTH_TILE_URL=
# VITE_EARTH_TILE_ATTRIBUTION=
# VITE_EARTH_LABELS_TILE_URL=
# VITE_EARTH_LABELS_ATTRIBUTION=

# Optional Mapbox access token (required only when VITE_EARTH_TILE_PROVIDER=mapbox_satellite)
# VITE_MAPBOX_ACCESS_TOKEN=
